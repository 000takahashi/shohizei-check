{
  // Cloudflare Workers の設定。GitHub の main に push すると自動で公開される（Workers Builds）。
  // 画面は site/ の静的ファイル。src/worker.js は www の転送と、仮URLを検索に載せない処理だけ。
  "name": "shohizei-check",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    // 無いページは site/404.html を 404 で返す（真っ白にしない）
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "shohizei-check.com", "custom_domain": true },
    { "pattern": "www.shohizei-check.com", "custom_domain": true }
  ],
  // 見られた数・使われた数（日ごとの合計だけ・src/count.mjs）。Traveln・ChronoDrawer と同じ D1 の ck_count に書く
  "d1_databases": [
    { "binding": "COUNTS", "database_name": "chronodrawer-reports", "database_id": "65392442-29b6-4eef-a354-b8d9024d3442" }
  ],
  "observability": { "enabled": true }
}
